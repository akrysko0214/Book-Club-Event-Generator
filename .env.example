# Copy this file to .env.local and fill in real values.
# .env.local is never uploaded to GitHub.

# Neon connection string (Neon dashboard → Connect → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Random secret used to sign login cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Address of the site. Use your Vercel URL in production.
BETTER_AUTH_URL="http://localhost:3000"

# Anthropic API key (platform.claude.com -> API Keys). Never put it in code.
ANTHROPIC_API_KEY=""

# Stripe (TEST mode keys while practicing). Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=""
# Price ID of the $9.99/month product (starts with price_)
STRIPE_PRICE_ID=""
# Webhook signing secret (starts with whsec_). Only needed on the live site.
STRIPE_WEBHOOK_SECRET=""

# Resend API key for sending invitations (resend.com -> API Keys).
# Invitations come from invitations@getbookedandbusy.app.
RESEND_API_KEY=""
